{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "verkkokyyla",
  "version": "0.1.1",
  "identifier": "com.verkkokyyla.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Verkkokyylä",
        "width": 1024,
        "height": 768
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "tero-k",
    "copyright": "Copyright © 2026 tero-k",
    "category": "DeveloperTool",
    "shortDescription": "Desktop network toolbox with MikroTik management",
    "longDescription": "Verkkokyylä is a desktop network toolbox: ping, traceroute, download benchmark, LAN scanner, MTU discovery, DNS diagnostics, and MikroTik router monitoring, logs, terminals, and backups.",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": ["resources/manuf", "resources/manuf.SHA256"]
  }
}
